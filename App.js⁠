      {currentScreen === 'booking' && (
        <ScrollView contentContainerStyle={styles.scrollContainer}>
          <Text style={styles.eyebrow}>SEM CITY COLLECTIVE PRESENTS</Text>
          <Text style={styles.screenHeading}>Choose Your Seat</Text>

          <View style={styles.tierToggleRow}>
            <TouchableOpacity
              style={[
                styles.tierBox,
                selectedTier === 'Town Family Table' && styles.tierBoxActive,
              ]}
              onPress={() => {
                setSelectedTier('Town Family Table');
                setPairingData(null);
                setActiveDish(null);
              }}
              activeOpacity={0.85}
            >
              <Text style={styles.tierLabel}>COMMUNAL</Text>
              <Text style={styles.tierTitle}>Town Family Table</Text>
              <Text style={styles.tierPrice}>$65</Text>
              <Text style={styles.tierDesc}>Long communal wooden tables • 3 courses • Shared vinyl vibes</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={[
                styles.tierBox,
                selectedTier === 'VIP Exquisite' && styles.tierBoxActive,
              ]}
              onPress={() => {
                setSelectedTier('VIP Exquisite');
                setPairingData(null);
                setActiveDish(null);
              }}
              activeOpacity={0.85}
            >
              <Text style={styles.tierLabelGold}>RESERVED</Text>
              <Text style={styles.tierTitle}>VIP Exquisite</Text>
              <Text style={styles.tierPriceGold}>$120</Text>
              <Text style={styles.tierDesc}>Intimate seating • Full 4 courses • Botanical aromatic flight</Text>
            </TouchableOpacity>
          </View>

          <View style={styles.sommelierHeaderRow}>
            <Text style={styles.sommelierTitle}>The Flavor Sommelier</Text>
            <Text style={styles.sommelierSub}>
              Tap dishes to preview aroma bouquets & Chris's track cuts
            </Text>
          </View>

          {tierDishes.map((dish) => {
            const isSelected = activeDish === dish.id;
            return (
              <View key={dish.id} style={styles.dishCard}>
                <View style={styles.dishTop}>
                  <View style={{ flex: 1, paddingRight: 8 }}>
                    <Text style={styles.dishBadge}>{dish.badge}</Text>
                    <Text style={styles.dishName}>{dish.name}</Text>
                    <Text style={styles.dishSide}>{dish.side}</Text>
                  </View>

                  <TouchableOpacity
                    style={[styles.pairPill, isSelected && styles.pairPillActive]}
                    onPress={() => handlePairing(dish)}
                    activeOpacity={0.8}
                  >
                    <Text style={styles.pairPillText}>
                      {isSelected ? 'Curated' : 'Pair'}
                    </Text>
                  </TouchableOpacity>
                </View>

                {isSelected && loadingPairing && (
                  <View style={styles.loaderArea}>
                    <ActivityIndicator color="#DDA74A" size="small" />
                    <Text style={styles.loaderText}>Blending terpenes with Town sound...</Text>
                  </View>
                )}

                {isSelected && pairingData && (
                  <View style={styles.pairingTray}>
                    <View style={styles.terpeneTagRow}>
                      <Text style={styles.terpeneTag}>🌿 {pairingData.primaryTerpene}</Text>
                      <Text style={styles.terpeneTag}>✨ {pairingData.secondaryTerpene}</Text>
                    </View>
                    <Text style={styles.pairingAroma}>"{pairingData.aromaBouquet}"</Text>
                    <Text style={styles.pairingBody}>{pairingData.palateNote}</Text>
                    <View style={styles.audioRow}>
                      <Text style={styles.audioLabel}>PROD. BY CHRIS</Text>
                      <Text style={styles.audioTrack}>{pairingData.townSoundtrack}</Text>
                    </View>
                    <Text style={styles.ritualText}>🕯️ {pairingData.sensoryRitual}</Text>
                  </View>
                )}
              </View>
            );
          })}

          <TouchableOpacity
            style={styles.ctaButton}
            onPress={() => alert(`Confirmed! You reserved: ${selectedTier}`)}
            activeOpacity={0.85}
          >
            <Text style={styles.ctaButtonText}>Reserve {selectedTier}</Text>
          </TouchableOpacity>

          <TouchableOpacity
            style={styles.ghostButton}
            onPress={() => setCurrentScreen('dashboard')}
          >
            <Text style={styles.ghostButtonText}>Back to Dashboard</Text>
          </TouchableOpacity>
        </ScrollView>
      )}
    </SafeAreaView>
  );
}

