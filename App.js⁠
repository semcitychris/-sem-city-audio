  {
    id: 'dish_4',
    name: 'Bourbon Peach Cobbler',
    side: 'Brown Sugar Chantilly Cream',
    tierAccess: ['VIP Exquisite'],
    badge: 'VIP FINALE',
  },
];

async function fetchDishSommelier(dish) {
  const fallbacks = {
    dish_1: {
      primaryTerpene: 'Limonene',
      secondaryTerpene: 'Caryophyllene',
      aromaBouquet: 'Cold-pressed lemon rind, cracked black peppercorn, warm savory batter.',
      palateNote: 'Sharp citrus cuts directly through the fried batter while pepper grounds the spice rub.',
      townSoundtrack: 'Sem City Chris — "Real One By Macz"',
      sensoryRitual: 'Inhale the citrus notes over the steam before your first bite.',
    },
    dish_2: {
      primaryTerpene: 'Myrcene',
      secondaryTerpene: 'Humulene',
      aromaBouquet: 'Earthy forest floor, slow-simmered greens, cured hickory woodsmoke.',
      palateNote: 'Deep myrcene reinforces the rich broth while woody humulene anchors the palate.',
      townSoundtrack: 'Sem City Chris — "Mobbin\' in the West"',
      sensoryRitual: 'Sip a spoonful of potlikker while the woodsy aroma clears the air.',
    },
    dish_3: {
      primaryTerpene: 'Caryophyllene',
      secondaryTerpene: 'Pinene',
      aromaBouquet: 'Toasted black pepper, pine needles, and sweet charred paprika.',
      palateNote: 'Pinene cleanses after rich butter fat, while warm caryophyllene balances the spice.',
      townSoundtrack: 'Sem City Chris — "Lake Merritt Sunset"',
      sensoryRitual: 'Crush fresh herbs between your fingers before taking a forkful of rice.',
    },
    dish_4: {
      primaryTerpene: 'Linalool',
      secondaryTerpene: 'Myrcene',
      aromaBouquet: 'Sun-warmed lavender, stewed peach stone fruit, roasted nutmeg.',
      palateNote: 'Floral linalool smooths over the bourbon kick and leaves a velvety finish.',
      townSoundtrack: 'Sem City Chris — "Late Night Soul"',
      sensoryRitual: 'Pair with warm herbal tea to let the lavender linger.',
    },
  };

  await new Promise((res) => setTimeout(res, 400));
  return fallbacks[dish.id] || fallbacks['dish_1'];
}

export default function App() {
  const [currentScreen, setCurrentScreen] = useState('onboarding');
  const [selectedTier, setSelectedTier] = useState('Town Family Table');
  const [activeDish, setActiveDish] = useState(null);
  const [pairingData, setPairingData] = useState(null);
  const [loadingPairing, setLoadingPairing] = useState(false);
  const [audioActive, setAudioActive] = useState(false);

  const tierDishes = POPUP_MENU.filter((item) =>
    item.tierAccess.includes(selectedTier)
  );

  const handlePairing = async (dish) => {
    setActiveDish(dish.id);
    setLoadingPairing(true);
    setPairingData(null);
    const result = await fetchDishSommelier(dish);
    setPairingData(result);
    setLoadingPairing(false);
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar barStyle="light-content" />

      {audioActive && (
        <View style={styles.hiddenAudio}>
          <WebView
            originWhitelist={['*']}
            source={{ html: audioBridgeHTML }}
            allowsInlineMediaPlayback={true}
            mediaPlaybackRequiresUserAction={false}
            javaScriptEnabled={true}
            style={{ width: 1, height: 1, opacity: 0 }}
          />
        </View>
      )}

      {audioActive && (
        <View style={styles.audioPillBar}>
          <View style={styles.audioIndicator} />
          <Text style={styles.audioPillText} numberOfLines={1}>
            NOW PLAYING: PROD. SEM CITY CHRIS — REAL ONE BY MACZ
          </Text>
        </View>
      )}

      {currentScreen === 'onboarding' && (
        <View style={styles.centerContainer}>
          <View style={styles.brandBadge}>
            <Text style={styles.brandBadgeText}>OAKLAND • CALIFORNIA</Text>
          </View>
          <Text style={styles.heroTitle}>SEM CITY</Text>
          <Text style={styles.heroSubtitle}>COLLECTIVE</Text>
          <View style={styles.dividerLine} />
          <Text style={styles.warningTag}>21+ COMMUNITY EXPERIENCE</Text>
          <Text style={styles.bodyCopy}>
            A curated pairing of plated soul comfort, botanical terpene flights, and soundtrack lineage curated by{' '}
            <Text style={styles.boldGold}>Sem City Chris</Text>.
            {'\n\n'}
            Physical government ID required upon arrival.
          </Text>

          <TouchableOpacity
            style={styles.ctaButton}
            onPress={() => {
              setAudioActive(true);
              setCurrentScreen('dashboard');
            }}
            activeOpacity={0.85}
          >
            <Text style={styles.ctaButtonText}>Enter The Collective 🔊</Text>
          </TouchableOpacity>
        </View>
      )}

      {currentScreen === 'dashboard' && (
        <View style={styles.centerContainer}>
          <Text style={styles.eyebrow}>CURRENT RESIDENCY</Text>
          <Text style={styles.heroTitle}>TOWN ENERGY</Text>
          <Text style={styles.locationMeta}>West Oakland Secret Courtyard • 7:00 PM</Text>

          <View style={styles.infoCard}>
            <Text style={styles.infoCardTitle}>The Three Pillars</Text>
            <Text style={styles.infoCardItem}>
              🍗 <Text style={styles.boldWhite}>Plated Comfort:</Text> Scratch recipes, heavy skillets, family plates
            </Text>
            <Text style={styles.infoCardItem}>
              🔊 <Text style={styles.boldWhite}>The Town Sound:</Text> Production by Sem City Chris
            </Text>
            <Text style={styles.infoCardItem}>
              🌿 <Text style={styles.boldWhite}>Botanical Flight:</Text> Non-combustive aromatic terpene pairings
            </Text>
          </View>

          <TouchableOpacity
            style={styles.ctaButton}
            onPress={() => setCurrentScreen('booking')}
            activeOpacity={0.85}
          >
            <Text style={styles.ctaButtonText}>Reserve Table & View Pairings</Text>
